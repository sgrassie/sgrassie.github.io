---
layout: null
---
[
  {% for post in site.posts %}
    {
      "title": {{ post.title | jsonify }},
      "tags": {{ post.tags | jsonify }},
      "excerpt": {{ post.excerpt | strip_html | normalize_whitespace | truncatewords: 32 | jsonify }},
      "content": {{ post.content | strip_html | normalize_whitespace | truncate: 2500 | jsonify }},
      "url": {{ post.url | relative_url | jsonify }},
      "date": {{ post.date | date: '%Y-%m-%d' | jsonify }},
      "pretty_date": {{ post.date | date: '%-d %b %Y' | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
